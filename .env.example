# ─── Server ───────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development
BASE_URL=http://localhost:5050
FRONTEND_URL=http://localhost:3001
# Reverse proxies in front of the app (Caddy/Nginx = 1, none = 0). Needed for correct
# per-user rate limiting behind a proxy. Set it to 1 in production behind one proxy.
TRUST_PROXY=0

# ─── MongoDB ──────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017/indexmenow
# Atlas:     mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# (Atlas → Network Access must allow wherever the backend runs.)
MONGODB_URI=mongodb://localhost:27017/indexmenow
# Only if the backend fails with "querySrv ECONNREFUSED" on a mongodb+srv:// URI: Node cannot reach
# the system DNS server (some VPN / DNS-proxy setups). Resolve through public DNS instead.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars

# ─── Google OAuth ─────────────────────────────────────────────────────
# Setup: console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:5050/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5050/api/oauth/google/callback

# ─── Platform Service Account ─────────────────────────────────────────
# The account that publishes to the Indexing API (see PUBLISH_CREDENTIAL_MODE).
# It must be an Owner of the Search Console property covering BASE_URL, because
# the wrapper pages are served from BASE_URL. Add more via the Admin API —
# accounts only add quota if they belong to DIFFERENT Google Cloud projects.
PLATFORM_SA_EMAIL=
PLATFORM_SA_PRIVATE_KEY=
PLATFORM_SA_PROJECT_ID=

# ─── Who publishes to the Indexing API ────────────────────────────────
#   platform        service accounts only; users' tokens never publish and users
#                   are not asked for the Indexing scope (lowest risk for users)
#   platform_first  service accounts first, user's token only as fallback (default)
#   user_first      user's token first, service account as fallback
PUBLISH_CREDENTIAL_MODE=platform_first
# Indexing API quota is per Google Cloud project, so every publish made with a
# user's token spends from this one shared daily budget (resets midnight Pacific)
OAUTH_DAILY_PUBLISH_LIMIT=180
# Optional. Search Console property owning BASE_URL; defaults to https://<BASE_URL host>/
PLATFORM_GSC_SITE_URL=

# ─── Queue Config ─────────────────────────────────────────────────────
# Delay before a job is sent to Google. Lower = faster, but a burst of
# identical-looking submissions is less "natural".
QUEUE_MIN_DELAY_MINUTES=1
QUEUE_MAX_DELAY_MINUTES=3
DOMAIN_CONCURRENT_LIMIT=3
USER_DAILY_CAP=50

# ─── Index status checks ──────────────────────────────────────────────
# Each job is checked every 30 min for 6h, then 2h up to 24h, then 6h.
INDEX_CHECK_CRON=*/15 * * * *
INDEX_CHECK_FIRST_AFTER_MINUTES=20

# ─── IndexNow (optional; Bing/Yandex only, wrapper URLs only — not Google) ──
# 8-128 chars: letters, digits, dashes. Served at BASE_URL/indexnow.txt
INDEXNOW_KEY=

# ─── Pre-flight scan (checks a URL before it is sent to Google) ───────
# Submit refuses URLs the scan finds unindexable (404, noindex, blocked by robots.txt, ...).
PREFLIGHT_ON_SUBMIT=true
PREFLIGHT_MAX_URLS=100              # URLs per scan request
PREFLIGHT_CONCURRENCY=16            # scanned in parallel per request
PREFLIGHT_GLOBAL_CONCURRENCY=64     # ... across all requests
PREFLIGHT_PER_HOST_CONCURRENCY=4    # ... against one website (keeps it polite)
PREFLIGHT_TIMEOUT_MS=10000          # time budget per URL, redirects included
# DNS lookups share libuv's thread pool (default 4); the app raises it to 16 unless set here.
# UV_THREADPOOL_SIZE=16

# ─── Job Config ───────────────────────────────────────────────────────
WRAPPER_EXPIRY_HOURS=72
MAX_RETRY_COUNT=3
RETRY_MIN_WAIT_HOURS=24
FAIL_AFTER_DAYS=7
# Failed Indexing API calls (quota waits don't count) before the job fails and is refunded
MAX_PUBLISH_ATTEMPTS=5

# ─── Admin ────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=change-this-to-another-long-random-string
