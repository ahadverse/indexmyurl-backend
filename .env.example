# ─── Server ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/indexmenow

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars

# ─── Google OAuth ─────────────────────────────────────────────────────
# Setup: console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ─── Platform Service Account (Optional fallback) ─────────────────────
# Used only when user hasn't connected their Google account
PLATFORM_SA_EMAIL=
PLATFORM_SA_PRIVATE_KEY=
PLATFORM_SA_PROJECT_ID=

# ─── Queue Config ─────────────────────────────────────────────────────
QUEUE_MIN_DELAY_MINUTES=5
QUEUE_MAX_DELAY_MINUTES=15
DOMAIN_CONCURRENT_LIMIT=3
USER_DAILY_CAP=50

# ─── Job Config ───────────────────────────────────────────────────────
WRAPPER_EXPIRY_HOURS=72
MAX_RETRY_COUNT=3
RETRY_MIN_WAIT_HOURS=24
FAIL_AFTER_DAYS=7

# ─── Admin ────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=change-this-to-another-long-random-string
